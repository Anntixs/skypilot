<Window x:Class="SkyPilot.App.Views.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение к SkyNetwork" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <StackPanel Margin="18">
    <Label Content="Позывной"/>
    <TextBox x:Name="CallsignBox" CharacterCasing="Upper" MaxLength="12"/>
    <Label Content="Тип ВС"/>
    <TextBox x:Name="TypeBox" CharacterCasing="Upper" MaxLength="4" ToolTip="ICAO-код, например A20N или B738"/>
    <Label Content="Сервер"/>
    <ComboBox x:Name="ServerBox" DisplayMemberPath="Name"/>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="ПОДКЛЮЧИТЬСЯ" IsDefault="True" Click="OnOk" Style="{StaticResource GreenButton}" Margin="0,0,8,0"/>
      <Button Content="ОТМЕНА" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
