<Window x:Class="SkyPilot.App.Views.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to SkyNetwork" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <StackPanel Margin="18">
    <Label Content="Callsign"/>
    <TextBox x:Name="CallsignBox" CharacterCasing="Upper" MaxLength="12"/>
    <Label Content="Aircraft type"/>
    <TextBox x:Name="TypeBox" CharacterCasing="Upper" MaxLength="4" ToolTip="ICAO code, e.g. A20N or B738"/>
    <Label Content="Server"/>
    <ComboBox x:Name="ServerBox" DisplayMemberPath="Name"/>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="CONNECT" IsDefault="True" Click="OnOk" Style="{StaticResource GreenButton}" Margin="0,0,8,0"/>
      <Button Content="CANCEL" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
