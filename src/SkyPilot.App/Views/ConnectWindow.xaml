<Window x:Class="SkyPilot.App.Views.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение к SkyNetwork" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <StackPanel Margin="16">
    <Label Content="Позывной"/>
    <TextBox x:Name="CallsignBox" CharacterCasing="Upper" MaxLength="12"/>
    <Label Content="Тип ВС (ICAO, например A20N, B738)"/>
    <TextBox x:Name="TypeBox" CharacterCasing="Upper" MaxLength="4"/>
    <Label Content="Сервер"/>
    <ComboBox x:Name="ServerBox" DisplayMemberPath="Name"/>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Подключиться" IsDefault="True" Click="OnOk"/>
      <Button Content="Отмена" IsCancel="True" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
