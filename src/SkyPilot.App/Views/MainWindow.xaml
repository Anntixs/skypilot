<Window x:Class="SkyPilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1040" Height="480" MinWidth="860" MinHeight="420"
        Topmost="{Binding Topmost}" Style="{StaticResource SkyWindow}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top bar: flight plan status (filed on the website) and "always on top" pin -->
    <DockPanel Margin="0,0,0,10">
      <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Topmost}"
                    Content="📌" Padding="10,6" Margin="8,0,0,0" ToolTip="Always on top"/>
      <Button DockPanel.Dock="Right" Content="REFRESH" Margin="8,0,0,0" Click="OnRefreshFlightPlanClick"
              ToolTip="Load the filed flight plan from the website"/>
      <Button x:Name="FlightPlanButton" Content="{Binding FlightPlanText}" FontSize="14" Padding="14,9"
              Click="OnFlightPlanClick" ToolTip="File a flight plan on the SkyNetwork website">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource RedButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasFlightPlan}" Value="True">
                <Setter Property="Background" Value="{StaticResource Ok}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="300"/>
        <ColumnDefinition Width="400"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Chat -->
      <DockPanel Margin="0,0,12,0">
        <TextBlock DockPanel.Dock="Top" Margin="4,0,0,4" FontSize="12">
          <Run Text="TX" Foreground="{StaticResource Muted}"/>
          <Run Text="{Binding TxFrequency, Mode=OneWay}"/>
        </TextBlock>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Content="SEND" Margin="8,0,0,0" Click="OnSendClick"/>
          <TextBox x:Name="Input" KeyDown="OnInputKeyDown" FontFamily="Consolas"
                   ToolTip="Text is sent on the TX frequency. Commands: .help"/>
        </DockPanel>
        <Border Style="{StaticResource Box}" Padding="4">
          <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                      Background="Transparent" BorderThickness="0" Padding="0,4,0,0">
            <TabControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Unread}" Value="True">
                          <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate>
                <ListBox ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="OnChatLoaded">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock TextWrapping="Wrap" Foreground="{Binding Color}">
                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="#6E6E6E"/>
                        <Run Text="{Binding From, Mode=OneWay}" FontWeight="Bold"/><Run Text=": "/>
                        <Run Text="{Binding Text, Mode=OneWay}"/>
                      </TextBlock>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </Border>
      </DockPanel>

      <!-- Transponder and radios -->
      <StackPanel Grid.Column="1">
        <TextBlock Text="XPDR" Style="{StaticResource Caption}"/>
        <Border Style="{StaticResource Box}" Margin="0,0,0,10">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="ID" Width="64" Click="OnIdentClick" ToolTip="IDENT">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Identing}" Value="True">
                      <Setter Property="Background" Value="{StaticResource Ok}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Toggle}" Width="96" Margin="0,0,10,0"
                          IsChecked="{Binding ModeC}" Content="{Binding ModeCText}" Click="OnModeCClick"
                          ToolTip="Transponder mode: Standby / Mode C"/>
            <TextBox x:Name="SquawkBox" Style="{StaticResource Readout}" Text="{Binding Squawk, Mode=OneWay}"
                     MaxLength="4" KeyDown="OnSquawkKeyDown" ToolTip="Type the code and press Enter"/>
          </DockPanel>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="COM 1" Style="{StaticResource Caption}"/>
            <Border Style="{StaticResource Box}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                  <ToggleButton Style="{StaticResource Toggle}" Content="RX" Width="54" Margin="0,0,0,6"
                                IsChecked="{Binding Com1Rx}" Click="OnRxTxClick"/>
                  <ToggleButton Style="{StaticResource Toggle}" Content="TX" Width="54"
                                IsChecked="{Binding Com1Tx}" Click="OnRxTxClick"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBox x:Name="Com1Box" Style="{StaticResource Readout}" Text="{Binding Com1, Mode=OneWay}"
                           MaxLength="7" KeyDown="OnComKeyDown" Tag="1" ToolTip="Type the frequency and press Enter"/>
                  <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Com1Station, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                    <Run Text="{Binding Com1Heard, Mode=OneWay}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="COM 2" Style="{StaticResource Caption}"/>
            <Border Style="{StaticResource Box}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                  <ToggleButton Style="{StaticResource Toggle}" Content="RX" Width="54" Margin="0,0,0,6"
                                IsChecked="{Binding Com2Rx}" Click="OnRxTxClick"/>
                  <ToggleButton Style="{StaticResource Toggle}" Content="TX" Width="54"
                                IsChecked="{Binding Com2Tx}" Click="OnRxTxClick"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBox x:Name="Com2Box" Style="{StaticResource Readout}" Text="{Binding Com2, Mode=OneWay}"
                           MaxLength="7" KeyDown="OnComKeyDown" Tag="2" ToolTip="Type the frequency and press Enter"/>
                  <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Com2Station, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                    <Run Text="{Binding Com2Heard, Mode=OneWay}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Grid>

        <DockPanel Margin="0,10,0,0">
          <!-- Push-to-talk: transmits on the TX radio while held; red while on the air -->
          <Button DockPanel.Dock="Right" Content="{Binding PttText}" Width="120"
                  PreviewMouseLeftButtonDown="OnPttDown" PreviewMouseLeftButtonUp="OnPttUp" LostMouseCapture="OnPttUp"
                  ToolTip="Hold to talk on the TX frequency. Assign the push-to-talk key in Settings">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Transmitting}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Bad}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <TextBlock Margin="4,0,0,0" Foreground="{StaticResource Muted}" FontSize="12">
            <Run Text="Nearby traffic:"/>
            <Run Text="{Binding TrafficCount, Mode=OneWay}" Foreground="{StaticResource Fg}"/>
          </TextBlock>
        </DockPanel>
      </StackPanel>

      <!-- ATC -->
      <DockPanel Grid.Column="2" Width="200" Margin="12,0,0,0"
                 Visibility="{Binding AtcVisible, Converter={StaticResource BoolToVis}}">
        <TextBlock DockPanel.Dock="Top" Text="ATC" Style="{StaticResource Caption}"/>
        <Border Style="{StaticResource Box}" Padding="2">
          <!-- Double click: tune the TX radio (ATIS stations: request the ATIS). Right click: menu -->
          <ListBox x:Name="ControllerList" ItemsSource="{Binding Controllers}" Background="Transparent" BorderThickness="0"
                   MouseDoubleClick="OnControllerDoubleClick"
                   ToolTip="Double-click to tune the TX radio (ATIS: request ATIS). Right-click for menu">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Request ATIS" Click="OnRequestAtisClick"
                          ToolTip="ATIS station: ATIS text; controller: controller info"/>
                <Separator/>
                <MenuItem Header="Tune COM1 to frequency" Click="OnTuneCom1Click"/>
                <MenuItem Header="Tune COM2 to frequency" Click="OnTuneCom2Click"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- The row tooltip shows the last ATIS / controller information, once received -->
                <DockPanel Margin="2,2" ToolTip="{Binding AtisText}" ToolTipService.ShowDuration="60000">
                  <Border DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="3" Padding="5,0"
                          Margin="4,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding HasLetter, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Letter}" FontWeight="Bold" Foreground="{StaticResource Bg}"/>
                  </Border>
                  <TextBlock Text="{Binding Callsign}" Width="92" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Frequency}" Width="56" Foreground="{StaticResource Accent}"/>
                  <TextBlock Text="{Binding Facility}" Foreground="{StaticResource Muted}" FontSize="11"
                             VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </Grid>

    <!-- Bottom bar -->
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <Button x:Name="ConnectButton" Content="{Binding ConnectButtonText}" Width="130" Margin="0,0,8,0"
              Click="OnConnectClick" ToolTip="Connect to / disconnect from the network">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource RedButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding NetConnected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Ok}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <ToggleButton Style="{StaticResource Toggle}" Content="ATC" Width="100" Margin="0,0,8,0" IsChecked="{Binding AtcVisible}"/>
      <Button Content="SETTINGS" Width="120" Click="OnSettingsClick"/>
      <!-- Voice server connection: green when connected, red when it failed; click to reconnect -->
      <Button Content="{Binding VoiceText}" Width="100" Margin="8,0,0,0" Click="OnVoiceClick" ToolTip="{Binding VoiceTip}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding VoiceConnected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Ok}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding VoiceFailing}" Value="True">
                <Setter Property="Background" Value="{StaticResource Bad}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <TextBlock DockPanel.Dock="Right" FontSize="12">
        <Run Text="UTC" Foreground="{StaticResource Muted}"/>
        <Run Text="{Binding UtcTime, Mode=OneWay}"/>
      </TextBlock>
      <TextBlock Text="{Binding SimStatus}" ToolTip="{Binding SimError}" Foreground="{StaticResource Muted}"
                 FontSize="12" HorizontalAlignment="Right" Margin="0,0,20,0"/>
    </DockPanel>
  </Grid>
</Window>
