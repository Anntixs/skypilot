<Window x:Class="SkyPilot.App.Views.FlightPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="План полёта" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <StackPanel Margin="16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <Label Content="Правила"/>
        <ComboBox x:Name="RulesBox" SelectedIndex="0">
          <ComboBoxItem Content="IFR"/>
          <ComboBoxItem Content="VFR"/>
        </ComboBox>
        <Label Content="Вылет (ICAO)"/>
        <TextBox x:Name="DepBox" CharacterCasing="Upper" MaxLength="4"/>
        <Label Content="Время вылета UTC (ЧЧММ)"/>
        <TextBox x:Name="DepTimeBox" MaxLength="4"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <Label Content="Тип ВС"/>
        <TextBox x:Name="TypeBox" CharacterCasing="Upper"/>
        <Label Content="Назначение (ICAO)"/>
        <TextBox x:Name="DestBox" CharacterCasing="Upper" MaxLength="4"/>
        <Label Content="Время в пути (ЧЧ:ММ)"/>
        <TextBox x:Name="EnrouteBox"/>
      </StackPanel>
      <StackPanel Grid.Column="4">
        <Label Content="Эшелон / высота"/>
        <TextBox x:Name="AltBox" CharacterCasing="Upper"/>
        <Label Content="Запасной (ICAO)"/>
        <TextBox x:Name="AltnBox" CharacterCasing="Upper" MaxLength="4"/>
        <Label Content="Топливо (ЧЧ:ММ)"/>
        <TextBox x:Name="FuelBox"/>
      </StackPanel>
    </Grid>
    <Label Content="Истинная скорость (узлы)"/>
    <TextBox x:Name="TasBox" Width="120" HorizontalAlignment="Left"/>
    <Label Content="Маршрут"/>
    <TextBox x:Name="RouteBox" CharacterCasing="Upper" TextWrapping="Wrap" Height="60" AcceptsReturn="False"/>
    <Label Content="Примечания"/>
    <TextBox x:Name="RemarksBox"/>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="SendButton" Content="Отправить" IsDefault="True" Click="OnOk"/>
      <Button Content="Отмена" IsCancel="True" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
