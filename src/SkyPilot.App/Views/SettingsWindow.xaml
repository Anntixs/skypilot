<Window x:Class="SkyPilot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource SkyWindow}">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="24"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <Label Content="CID"/>
      <TextBox x:Name="CidBox"/>
      <Label Content="Пароль"/>
      <PasswordBox x:Name="PasswordBox"/>
      <Label Content="Имя"/>
      <TextBox x:Name="NameBox" ToolTip="Так вас видят диспетчеры"/>
      <Label Content="Адрес сервера"/>
      <TextBox x:Name="ServerBox" ToolTip="Хост или хост:порт, например 127.0.0.1:6809"/>
      <Label Content="Сайт SkyNetwork"/>
      <TextBox x:Name="WebsiteBox" ToolTip="Здесь подаются планы полёта"/>
      <CheckBox x:Name="SoundBox" Content="Звук при личном сообщении" Margin="0,14,0,0"/>
      <CheckBox x:Name="TopmostBox" Content="Окно поверх остальных" Margin="0,8,0,0"/>
    </StackPanel>

    <!-- Radio voice -->
    <StackPanel Grid.Column="2">
      <Label Content="Микрофон"/>
      <ComboBox x:Name="InputBox"/>
      <Label Content="Динамики / наушники"/>
      <ComboBox x:Name="OutputBox"/>
      <DockPanel>
        <TextBlock x:Name="MicGainText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"
                   Foreground="{StaticResource Muted}"/>
        <Label Content="Усиление микрофона"/>
      </DockPanel>
      <Slider x:Name="MicGainSlider" Minimum="0" Maximum="300" SmallChange="5" LargeChange="25"
              IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
      <ProgressBar x:Name="MicMeter" Height="6" Minimum="0" Maximum="1" Margin="0,4,0,0" BorderThickness="0"
                   Foreground="{StaticResource Ok}" Background="{StaticResource Panel}"
                   ToolTip="Уровень микрофона (виден, когда голосовая связь подключена)"/>
      <DockPanel>
        <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"
                   Foreground="{StaticResource Muted}"/>
        <Label Content="Громкость приёма"/>
      </DockPanel>
      <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
              IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
      <Label Content="Клавиша передачи (PTT)"/>
      <DockPanel>
        <Button x:Name="PttCaptureButton" DockPanel.Dock="Right" Content="НАЗНАЧИТЬ" Width="130" Margin="8,0,0,0"
                Click="OnPttCaptureClick" ToolTip="Нажмите, затем нажмите клавишу или кнопку джойстика"/>
        <Button DockPanel.Dock="Right" Content="✕" Margin="8,0,0,0" Click="OnPttClearClick" ToolTip="Убрать клавишу"/>
        <TextBox x:Name="PttBox" IsReadOnly="True" Focusable="False"/>
      </DockPanel>
      <Label Content="Порт голосового сервера (UDP)"/>
      <TextBox x:Name="VoicePortBox" ToolTip="Голосовой сервер работает на том же хосте, что и FSD-сервер. По умолчанию 3782"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="СОХРАНИТЬ" IsDefault="True" Click="OnOk" Style="{StaticResource GreenButton}" Margin="0,0,8,0"/>
        <Button Content="ОТМЕНА" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
