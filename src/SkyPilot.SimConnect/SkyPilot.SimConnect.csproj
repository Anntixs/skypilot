<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Talks to MSFS 2020/2024 through the SimConnect C API. SimConnect.dll is loaded at run time
    (next to SkyPilot.exe or from the MSFS SDK), so no SDK is needed to build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>SkyPilot.SimConnect</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkyPilot.Core\SkyPilot.Core.csproj" />
  </ItemGroup>
</Project>
